    "BeaconDialogHeader": {
      "props": {
        "title": "string",
        "badge": {
          "enum": [
            "bell-ring",
            "circle-arrow-up",
            "circle-check",
            "circle-x",
            "download",
            "gauge",
            "info",
            "mail-check",
            "network",
            "package-plus",
            "triangle-alert",
            "upload",
            "webhook"
          ]
        }
      },
      "body": [
        {
          "id": "s_bcndialogheader_001",
          "kind": "frame",
          "padding": [
            16,
            24
          ],
          "width": "fill_container",
          "justifyContent": "space_between",
          "alignItems": "center",
          "stroke": "$border-subtle",
          "strokeWidth": {
            "bottom": 1
          },
          "children": [
            {
              "id": "s_bcndialogheader_002",
              "kind": "frame",
              "gap": "$spacing-sm",
              "alignItems": "center",
              "children": [
                {
                  "id": "s_bcndialogheader_003",
                  "kind": "frame",
                  "width": 28,
                  "height": 28,
                  "justifyContent": "center",
                  "alignItems": "center",
                  "fill": "$accent-primary-soft",
                  "cornerRadius": "$radius-sm",
                  "children": [
                    {
                      "id": "s_bcndialogheader_004",
                      "kind": "icon",
                      "name": {
                        "$param": "badge"
                      },
                      "size": 15,
                      "fill": "$accent-primary"
                    }
                  ]
                },
                {
                  "id": "s_bcndialogheader_005",
                  "kind": "text",
                  "text": {
                    "$param": "title"
                  },
                  "fontSize": "$font-size-md",
                  "fontWeight": "600",
                  "fontFamily": "$font-sans",
                  "wrap": "nowrap",
                  "fill": "$foreground-primary"
                }
              ]
            },
            {
              "id": "s_bcndialogheader_006",
              "kind": "icon",
              "name": "x",
              "size": 16,
              "fill": "$foreground-muted"
            }
          ]
        }
      ]
    },
